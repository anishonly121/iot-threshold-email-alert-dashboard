{
  "version": 2,
  "builds": [
    { "src": "api/send-alert.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/send-alert", "dest": "/api/send-alert.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
